---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
{% assign site_origin = site.url | default: 'https://zaryob.github.io' %}
{% assign site_root = '/' | relative_url | prepend: site_origin %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>{{ site_root }}</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site_root }}?lang=en" />
    <xhtml:link rel="alternate" hreflang="tr" href="{{ site_root }}?lang=tr" />
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  {% for architecture in site.data.syscall_release.architectures %}
  <url>
    <loc>{{ site_root }}?arch={{ architecture.id }}</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site_root }}?arch={{ architecture.id }}&amp;lang=en" />
    <xhtml:link rel="alternate" hreflang="tr" href="{{ site_root }}?arch={{ architecture.id }}&amp;lang=tr" />
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
  {% endfor %}
</urlset>
